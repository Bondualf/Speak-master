{
   "background": {
      "persistent": true,
      "scripts": [ "scripts/background.js" ]
   },
   "browser_action": {
      "default_icon": {
         "128": "images/icon-128.png",
         "16": "images/icon-16.png"
      },
      "default_popup": "popup.html",
      "default_title": "Speak-master"
   },
   "content_scripts": [ {
      "all_frames": true,
      "match_about_blank": true,
      "js": [ "scripts/cscript.js" ],
      "matches": [ "http://*/*", "https://*/*" ],
      "run_at": "document_end"
   } ],
   "default_locale": "ru",
   "description": "Чтение текста голосом с умной подсветкой",
   "icons": {
      "128": "images/icon-128.png",
      "16": "images/icon-16.png"
   },
   "key": "",
   "manifest_version": 2,
   "name": "Speak-master",
   "permissions": [ "<all_urls>", "tabs", "tts", "storage", "contextMenus", "commands" ],
   "version": "0.0.4"
}